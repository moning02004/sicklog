# 복사해서 .env로 쓰세요:  cp .env.example .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 로컬은 http라서 보안 쿠키를 끈다. 운영(https)에서는 1
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=sicklog
POSTGRES_USER=sicklog
POSTGRES_PASSWORD=sicklog
DATABASE_URL=postgres://sicklog:sicklog@db:5432/sicklog

# Django 관리자 화면 주소 (비워 두면 꺼짐). 운영에서는 짐작하기 어려운 주소로
DJANGO_ADMIN_URL=django-admin/

# 최고관리자 (처음 실행할 때 만들어짐)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=0000
DJANGO_ADMIN_NAME=최고관리자

# 새로 추가하는 사용자의 기본 비밀번호
SICKLOG_DEFAULT_PASSWORD=0000

# Web Push: make vapid 로 만든 값을 넣으세요 (비워 두면 알림 없이 동작)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

TIME_ZONE=Asia/Seoul
